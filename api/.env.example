# Which OpenAI-compatible endpoint serves the open model.
#   groq      -> https://api.groq.com/openai/v1   (demo default; free tier works)
#   together  -> https://api.together.xyz/v1
#   openrouter-> https://openrouter.ai/api/v1
#   vllm      -> your self-hosted vLLM server (the production story)
#   ollama    -> http://localhost:11434/v1        (laptop, no key)
#   mock      -> no network, canned answers built from the form spec
MODEL_PROVIDER=groq

# Only needed for hosted providers. Get a Groq key at https://console.groq.com/keys
MODEL_API_KEY=

# Open-weight chat model with tool calling. Leave blank to use the provider default.
#   groq default: openai/gpt-oss-120b   (fallbacks: openai/gpt-oss-20b, qwen/qwen3-32b)
MODEL_NAME=

# Override the base URL (required for vllm; optional elsewhere)
MODEL_BASE_URL=

# Speech-to-text (Whisper, open weights). Uses the same provider + key.
STT_MODEL=whisper-large-v3-turbo

# Comma-separated origins allowed to call the API (Leigh's dev server + deployed site)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

PORT=8787
